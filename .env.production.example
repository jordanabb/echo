# Production Environment Variables Template
# Copy this file to .env.production and fill in with actual values
# DO NOT commit .env.production to version control

# Database Configuration (AWS RDS)
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=echo_data
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/echo_data

# Backend Configuration
BACKEND_PORT=8000
# Add your production domain(s) to CORS_ORIGINS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend Configuration
# This should point to your production backend API
PUBLIC_API_URL=https://api.yourdomain.com

# Optional: AWS Specific
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Optional: Monitoring/Logging
# SENTRY_DSN=your_sentry_dsn
# LOG_LEVEL=info
