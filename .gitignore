# .gitignore at the root of the project

# Python
__pycache__/
*.pyc
.venv/
venv/


# Node
node_modules/
.DS_Store
dist/
.npm
npm-debug.log*


# Environment files (but keep .example files for templates)
.env
.env.local
.env.production
.env.development
.env.test
.env.deploy
!.env.example
!.env*.example


# IDE / Editor specific
.vscode/
.idea/

# Docker
*.log

# SvelteKit
.svelte-kit/
build/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Database dumps produced by scripts/echo.py dump-db
dumps/

# ETL source data and generated intermediates — several GB, far too large for
# git. These live in S3; fetch them with:  python scripts/echo.py pull-data
ECHO REVAMP/
packages/etl/clean_output_national/
packages/etl/clean_output/

# Line-wrapped copies of the docs, kept for sharing outside the repo. The .md
# files are canonical; committing both would let them drift apart.
docs/*.txt

# These two contain the production RDS password in plaintext, and this
# repository is public. Ignored so that `git add -A` cannot publish them.
# Redact the credentials before removing these lines.
docs/aws-infrastructure.md
docs/aws-infrastructure.txt
