# .gitignore at the root of the project

# Python
__pycache__/
*.pyc
.venv/
venv/


# Node
node_modules/
.DS_Store
dist/
.npm
npm-debug.log*


# Environment files (but keep .example files for templates)
.env
.env.local
.env.production
.env.development
.env.test
!.env.example
!.env*.example


# IDE / Editor specific
.vscode/
.idea/

# Docker
*.log

# SvelteKit
.svelte-kit/
build/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Production exports (generated by export script)
production_export/
