# Deployment configuration for the scripts in scripts/.
#
#   cp .env.deploy.example .env.deploy
#
# These are infrastructure identifiers, not secrets — but this repository is
# public, so they are kept out of version control. .env.deploy is git-ignored.
# Get the real values from whoever administers the AWS account, or read them
# out of docs/aws-infrastructure.md.

# Region everything lives in. ECR Public only answers in us-east-1, regardless
# of where the rest of the stack runs.
AWS_REGION=us-east-1

# --- Frontend (S3 + CloudFront) ---------------------------------------------
# S3 bucket holding the built SPA, and the CloudFront distribution in front of
# it. Deploys sync to the bucket then invalidate the distribution.
S3_FRONTEND_BUCKET=echo-frontend-static
CLOUDFRONT_DISTRIBUTION_ID=

# --- Backend (ECR Public + App Runner) --------------------------------------
# Full image URI (no tag — scripts append :latest) and the App Runner service
# ARN to redeploy. App Runner does not auto-deploy on image push, so the
# scripts trigger it explicitly.
ECR_IMAGE=public.ecr.aws/xxxxxxxx/echo-backend
APPRUNNER_SERVICE_ARN=

# --- Database (RDS) ---------------------------------------------------------
# Instance identifier, used for snapshots before risky changes.
RDS_INSTANCE_ID=echo-final

# --- Data staging (S3) ------------------------------------------------------
# Bucket holding ETL source data and database dumps, so a new machine can get
# set up without copying 3+ GB by hand. Create it if it does not exist yet:
#
#   aws s3 mb s3://your-bucket-name --region us-east-1
#
# This bucket must NOT be public — it holds database dumps.
ECHO_DATA_BUCKET=
